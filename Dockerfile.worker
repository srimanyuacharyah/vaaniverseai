FROM python:3.11-slim
WORKDIR /app
COPY requirements.txt ./
# Install worker extras (RQ + Redis client)
RUN pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir rq redis
COPY src ./src
EXPOSE 8000
# Default command is the RQ worker; compose overrides as needed
CMD ["rq", "worker"]
